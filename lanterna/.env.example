# =====================================================================
# Copie para .env e preencha. Sem nada preenchido o app roda em modo
# demonstração (catálogo real com artes ilustrativas, dados no navegador).
# =====================================================================

# --- TMDB: pôsteres, fundos, trailers e miniaturas oficiais -------------
# Variáveis SEM o prefixo VITE_ ficam só no servidor (proxy do Vite ou função
# da Vercel) e nunca chegam ao navegador. Preencha UMA delas:
TMDB_API_KEY=
TMDB_READ_TOKEN=
# Liga o uso do proxy /api/tmdb pelo frontend:
VITE_TMDB_PROXY=false

# --- Supabase (opcional): contas, listas e catálogo no banco ------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Com Supabase, a chave do TMDB vai como segredo da Edge Function:
#   supabase secrets set TMDB_API_KEY=sua_chave
VITE_TMDB_ENABLED=false
