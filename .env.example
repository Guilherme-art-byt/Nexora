# Copie para .env.local e preencha. Nunca coloque segredos em variáveis NEXT_PUBLIC_*.

# Endereço e chave pública do projeto Supabase (Painel > Project Settings > API Keys).
# Para o Supabase local: rode `npm run db:start` e depois `npm run db:env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente para scripts de servidor (seed). NUNCA expor ao navegador.
SUPABASE_SECRET_KEY=
